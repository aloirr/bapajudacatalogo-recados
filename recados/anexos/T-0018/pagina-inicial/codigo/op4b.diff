+/* ===== OPÇÃO 4 (simulação T-0018): "Marca em destaque" ===== */
+.inicio-marca .topo { background: var(--escuro); border-bottom-color: var(--escuro); }
+.inicio-marca .marca img { height: 52px; }
+.inicio-marca .marca span { color: #B9C4BC; border-left-color: #3A3F3B; }
+.inicio-marca .menu a { color: #E8ECE9; }
+.inicio-marca .menu a:hover { color: var(--verde); }
+.marca-faixa { color: var(--branco); position: relative; overflow: hidden;
+  background: radial-gradient(900px 420px at 88% 30%, rgba(98,187,71,.35) 0%, rgba(98,187,71,0) 65%),
+              linear-gradient(120deg, var(--escuro) 0%, #17301a 50%, var(--verde-esc) 100%); }
+.marca-faixa::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--verde); }
+.marca-faixa-in { max-width: 1200px; margin: 0 auto; padding: 26px 16px 34px; display: grid;
+  grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); grid-template-areas: "txt foto" "busca busca"; gap: 18px 32px; align-items: center; }
+.mf-texto { grid-area: txt; }
+.mf-selo { display: inline-block; margin: 0 0 14px; padding: 4px 12px; border-radius: 999px; background: rgba(98,187,71,.16); color: var(--verde); font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
+.marca-faixa h1 { font-size: clamp(28px, 3.3vw, 42px); line-height: 1.12; font-weight: 700; margin: 0 0 12px; }
+.marca-faixa h1 em { font-style: normal; color: var(--verde); }
+.marca-faixa p { margin: 0; color: #D5DDD7; font-size: 16px; max-width: 520px; }
+.mf-foto { grid-area: foto; display: flex; justify-content: center; }
+.mf-foto img { max-height: 190px; width: auto; filter: drop-shadow(0 18px 24px rgba(0,0,0,.45)); }
+.mf-busca { grid-area: busca; min-width: 0; }
+.mf-busca .cartao-busca { margin: 0; max-width: none; box-shadow: 0 16px 40px rgba(0,0,0,.35); }
+.difs { max-width: 1200px; margin: 0 auto; padding: 22px 16px 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
+.dif { background: var(--branco); border: 1px solid var(--linha); border-left: 4px solid var(--verde); border-radius: var(--raio); padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
+.dif b { font-size: 20px; color: var(--escuro); line-height: 1.2; }
+.dif span { font-size: 14px; color: var(--texto-2); }
+.destaques-bloco { padding-top: 28px; padding-bottom: 48px; }
+.dest-topo { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
+.dest-topo .sub { margin: 0; }
+.destaques { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
+.destaque { background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio); overflow: hidden; text-decoration: none; color: var(--texto); display: flex; flex-direction: column; transition: border-color .15s, box-shadow .15s, transform .15s; }
+.destaque:hover { border-color: var(--verde); box-shadow: var(--sombra); transform: translateY(-2px); }
+.d-foto { height: 170px; background: #FAFBFA; border-bottom: 1px solid var(--linha); }
+.d-foto img { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
+.d-txt { padding: 10px 14px 14px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.d-si { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--verde-txt); }
+.d-cod { font-size: 16px; color: var(--escuro); }
+.d-desc { font-size: 13px; color: var(--texto-2); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+@media (max-width: 900px) {
+  .marca-faixa-in { grid-template-columns: minmax(0, 1fr); grid-template-areas: "txt" "busca"; padding: 28px 16px 32px; }
+  .mf-foto { display: none; }
+  .destaques { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .difs { grid-template-columns: minmax(0, 1fr); gap: 10px; }
+}
