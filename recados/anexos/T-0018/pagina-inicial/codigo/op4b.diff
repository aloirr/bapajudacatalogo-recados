+.mf-geral input { flex: 1; min-width: 0; height: 64px; border: 1px solid var(--linha); border-radius: 10px; padding: 0 16px; font: inherit; font-size: 16px; color: var(--texto); background: var(--branco); }
+.mf-geral input:focus { outline: none; border-color: var(--verde-esc); box-shadow: 0 0 0 4px rgba(98,187,71,.25); }
