+.mf-bloco { background: var(--branco); border-radius: 12px; padding: 14px 16px 16px; box-shadow: 0 16px 40px rgba(0,0,0,.35); color: var(--texto); min-width: 0; }
+.v-rot { display: block; font-size: 12px; font-weight: 600; color: var(--texto-2); text-transform: uppercase; letter-spacing: .05em; margin: 0 0 6px; }
