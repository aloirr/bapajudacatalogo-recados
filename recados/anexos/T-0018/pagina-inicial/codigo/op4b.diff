+.v-placa-campo:focus-within { border-color: var(--verde-esc); box-shadow: 0 0 0 4px rgba(98,187,71,.25); }
+.v-placa-faixa { width: 34px; flex: none; background: var(--verde-esc); color: var(--branco); font-size: 11px; font-weight: 700; display: grid; place-items: end center; padding-bottom: 8px; letter-spacing: .04em; }
+.v-placa-campo input { flex: 1; min-width: 0; border: 0; outline: none; padding: 0 12px; font: inherit; font-size: 28px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--escuro); text-align: center; background: none; }
+.v-placa-campo input::placeholder { color: #B8BFBA; font-weight: 600; }
+.v-placa .bt { height: 64px; padding: 0 24px; font-size: 16px; }
+.v-placa .status-placa { margin: 8px 0 0; font-size: 13px; }
+/* Pesquisas recentes: 4 cartões e o selo "simulação" */
