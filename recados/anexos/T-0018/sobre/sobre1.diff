+.rec-todos:hover { text-decoration: underline; }
+.rec-lista { list-style: none; margin: 0; padding: 0 16px; background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio);
+  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
+.rec-lista li { border-top: 1px solid var(--linha); min-width: 0; }
+.rec-lista li:nth-child(-n+2) { border-top: 0; }
+.rec-item { display: flex; align-items: center; gap: 14px; min-height: 64px; padding: 8px 0; text-decoration: none; color: var(--texto); }
+.rec-foto { flex: none; width: 48px; height: 48px; border-radius: 8px; background: #FAFBFA; border: 1px solid var(--linha); overflow: hidden; display: grid; place-items: center; }
+.rec-foto img { width: 100%; height: 100%; object-fit: contain; padding: 3px; }
+.rec-foto .sem-foto { font-size: 0; }
+.rec-foto .sem-foto img { width: 30px; height: auto; padding: 0; }
+.rec-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
+.rec-txt b { font-size: 15px; color: var(--escuro); line-height: 1.25; }
+.rec-txt span { font-size: 13px; color: var(--texto-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.rec-si { flex: none; font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--verde-txt); }
+.rec-seta { flex: none; font-size: 22px; line-height: 1; color: #A9B1AC; width: 12px; text-align: right; }
+.rec-item:hover b { color: var(--verde-esc); }
+.rec-item:hover .rec-seta { color: var(--verde-esc); }
+.rec-item:focus-visible { outline: 3px solid var(--verde); outline-offset: 2px; border-radius: 6px; }
+@media (max-width: 900px) {
+  .rec-lista { grid-template-columns: minmax(0, 1fr); }
+  .rec-lista li:nth-child(2) { border-top: 1px solid var(--linha); }
+}
+@media (max-width: 640px) {
+  .recentes-bloco { padding-top: 18px; padding-bottom: 28px; }
+  .rec-topo { margin-bottom: 8px; }
+  .rec-topo h2 { font-size: 18px; }
+  .rec-topo .sub { font-size: 13px; }
+  .rec-todos { font-size: 13px; }
+  .rec-lista { padding: 0 12px; }
+  .rec-item { gap: 12px; min-height: 56px; padding: 6px 0; }
+  .rec-foto { width: 44px; height: 44px; }
+  .rec-txt b { font-size: 14px; }
+  .rec-si { display: none; }
+}
+@media (max-width: 640px) {
+  .rec-topo h2 { white-space: nowrap; }
+  .rec-topo .selo-sim { margin-left: 6px; padding: 1px 7px; font-size: 10px; }
+  .rec-todos { padding: 12px 0 2px; }
+}
+
+/* Sobre a BAP (simulação): texto da página "Empresa" do site institucional, fotos do catálogo */
+.sobre { --sb-larg: 1160px; }
+.sb-topo { color: var(--branco); overflow: hidden;
+  background: radial-gradient(900px 420px at 80% 45%, #2d6e22 0%, rgba(45,110,34,0) 62%), linear-gradient(115deg, #0f1410 0%, #182a14 55%, #23461b 100%); }
+.sb-topo-in { max-width: var(--sb-larg); margin: 0 auto; padding: 56px 16px 64px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: 32px; align-items: center; }
+.sb-selo { display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--escuro); background: var(--verde); border-radius: 999px; padding: 4px 12px; margin-bottom: 16px; }
+.sb-txt h1 { font-size: clamp(28px, 3.6vw, 44px); line-height: 1.12; margin: 0 0 18px; font-weight: 700; }
+.sb-txt h1 em { font-style: normal; color: var(--verde); }
+.sb-txt p { margin: 0; color: #D5DDD7; font-size: 17px; max-width: 520px; }
+.sb-fotos { position: relative; height: 320px; }
+.sb-fotos img { position: absolute; filter: drop-shadow(0 18px 24px rgba(0,0,0,.45)); }
+.sb-fotos .sf1 { width: 62%; left: 19%; top: 0; z-index: 2; }
+.sb-fotos .sf2 { width: 36%; left: 0; bottom: 0; }
+.sb-fotos .sf3 { width: 36%; right: 0; bottom: 6px; }
+.sb-corpo { max-width: var(--sb-larg); margin: 0 auto; padding: 0 16px 48px; }
+.sb-hist { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: -28px; position: relative; }
+.sb-bloco { background: var(--branco); border-radius: var(--raio); box-shadow: var(--sombra); padding: 24px 24px 26px; border-top: 4px solid var(--verde); }
+.sb-bloco h2 { font-size: 18px; line-height: 1.25; margin: 0 0 10px; color: var(--escuro); }
+.sb-bloco p { margin: 0; color: var(--texto-2); font-size: 15px; line-height: 1.65; }
+.sb-frase { margin: 44px auto 40px; max-width: 760px; text-align: center; padding: 0; }
+.sb-frase p { margin: 0 0 8px; font-size: clamp(21px, 2.4vw, 28px); line-height: 1.3; font-weight: 600; color: var(--escuro); }
+.sb-frase p::before { content: ""; display: block; width: 48px; height: 4px; border-radius: 2px; background: var(--verde); margin: 0 auto 18px; }
+.sb-frase span { font-size: 16px; color: var(--texto-2); }
+.sb-frase b { color: var(--verde-txt); }
+.sb-cta { display: grid; grid-template-columns: 200px minmax(0, 1fr) auto; align-items: center; gap: 24px; background: var(--escuro); color: var(--branco); border-radius: var(--raio); padding: 22px 32px; }
+.sb-cta img { width: 100%; filter: drop-shadow(0 10px 16px rgba(0,0,0,.5)); }
+.sb-cta h2 { margin: 0 0 4px; font-size: 22px; }
+.sb-cta p { margin: 0; color: #B9C4BC; }
+.sb-dados { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 24px 0 0; background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio); }
+.sb-dados div { padding: 18px 22px; border-left: 1px solid var(--linha); min-width: 0; }
+.sb-dados div:first-child { border-left: 0; }
+.sb-dados dt { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--texto-2); margin-bottom: 4px; }
+.sb-dados dd { margin: 0; font-weight: 600; color: var(--escuro); overflow-wrap: anywhere; }
+.sb-dados a { color: var(--verde-esc); text-decoration: none; }
+@media (max-width: 900px) {
+  .sb-topo-in { grid-template-columns: minmax(0, 1fr); padding: 36px 16px 56px; gap: 20px; }
+  .sb-fotos { height: 220px; max-width: 420px; width: 100%; margin: 0 auto; }
+  .sb-hist { grid-template-columns: minmax(0, 1fr); }
+  .sb-cta { grid-template-columns: minmax(0, 1fr); text-align: center; justify-items: center; padding: 24px 20px; gap: 14px; }
+  .sb-cta img { width: 180px; }
+  .sb-dados { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .sb-dados div:nth-child(3) { border-left: 0; }
+  .sb-dados div:nth-child(n+3) { border-top: 1px solid var(--linha); }
+}
+@media (max-width: 640px) {
+  .sb-txt h1 { font-size: 27px; }
+  .sb-txt p { font-size: 15px; }
+  .sb-fotos { height: 190px; }
+  .sb-bloco { padding: 18px 18px 20px; }
+  .sb-bloco h2 { font-size: 17px; }
+  .sb-bloco p { font-size: 14px; }
+  .sb-frase { margin: 32px auto 28px; }
+  .sb-cta .bt { width: 100%; justify-content: center; }
+  .sb-dados { grid-template-columns: minmax(0, 1fr); }
+  .sb-dados div { border-left: 0; padding: 14px 18px; }
+  .sb-dados div + div { border-top: 1px solid var(--linha); }
+}
