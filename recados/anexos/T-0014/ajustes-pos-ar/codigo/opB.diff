 }
+
+/* SIMULAÇÃO T-0019: miniatura da foto no item relacionado */
+.rel-mini { flex: none; width: 48px; height: 48px; border-radius: 6px; background: var(--branco); box-shadow: var(--contorno-neutro); display: grid; place-items: center; overflow: hidden; }
+.rel-mini img { width: 100%; height: 100%; object-fit: contain; padding: 3px; }
+.rel-mini img.sem { opacity: .25; padding: 10px; }
+.rel-txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
+a.item-rel:hover .rel-txt b { color: var(--verde-txt); }
+@media print { .rel-mini { display: none; } }
+/* opção B: faixa logo abaixo do cabeçalho, antes da aplicação; cartões pequenos lado a lado */
+.rel-b { display: flex; flex-wrap: wrap; gap: 0 12px; }
+.rel-b .secao { flex: 1 1 auto; display: flex; align-items: center; gap: 8px 16px; padding: 10px 12px; background: var(--verde-claro); border-color: transparent; }
+.rel-b .secao-tit { margin: 0; flex: none; color: var(--verde-txt); }
+.rel-b .itens-rel { display: flex; flex-wrap: wrap; gap: 8px; flex: 1 1 auto; min-width: 0; }
+.rel-b .itens-rel li { flex: 0 1 260px; min-width: 0; }
+.rel-b .item-rel { box-shadow: none; }
+@media (max-width: 640px) {
+  .rel-b .secao { flex-direction: column; align-items: stretch; }
+  .rel-b .itens-rel { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 2px; }
+  .rel-b .itens-rel li { flex: 0 0 min(260px, 78%); scroll-snap-align: start; }
+}
+@media (min-width: 641px) { .rel-b .secao-tit { width: 140px; } }
